{
  "name": "tanren",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "check": "pnpm check:plugins && biome ci --error-on-warnings . && pnpm typecheck && vitest run",
    "check:plugins": "node .biome/selftest.mjs",
    "dev": "pnpm run \"/^dev:(api|web)$/\"",
    "dev:api": "pnpm -F @tanren/worker dev",
    "dev:web": "pnpm web:serve",
    "db:migrate": "pnpm -F @tanren/worker db:migrate",
    "db:seed": "pnpm -F @tanren/worker db:seed",
    "db:reset": "pnpm -F @tanren/worker db:reset",
    "smoke:worker": "pnpm -F @tanren/worker smoke",
    "deploy:preflight": "pnpm -F @tanren/worker deploy:preflight",
    "web:export": "pnpm -F @tanren/mobile export:web",
    "web:serve": "pnpm -F @tanren/mobile serve:web",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "pnpm typecheck:root && pnpm -r typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
