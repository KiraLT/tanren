{
  // Test-only Worker config for the @tanren/db vitest project (docs/design/db.md §8).
  // Each test file gets isolated D1 storage; nothing here reaches Cloudflare.
  "name": "tanren-db-test",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanren-test",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
