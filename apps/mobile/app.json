{
  "expo": {
    "name": "Tanren",
    "slug": "tanren",
    "scheme": "tanren",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true, "bundleIdentifier": "me.tanren.app" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": { "typedRoutes": true }
  }
}
