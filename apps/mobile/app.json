{
  "expo": {
    "name": "Tanren",
    "slug": "tanren",
    "scheme": "tanren",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71f6f700-4c89-4627-8a93-b2fdd82974a5"
    },
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16181D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.tanren.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#16181D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "71f6f700-4c89-4627-8a93-b2fdd82974a5"
      }
    },
    "owner": "tanren"
  }
}
