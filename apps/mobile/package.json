{
  "name": "@tanren/mobile",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node --import ./scripts/resolveTs.ts scripts/serviceWorker.ts",
    "serve:web": "pnpm -F @tanren/worker exec wrangler dev -c wrangler.web.jsonc --port 8790",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --project @tanren/mobile",
    "images:generate": "node --env-file-if-exists=.env.images scripts/generateIllustrations.ts",
    "images:shrink": "node scripts/shrinkImages.ts",
    "images:map": "node --import ./scripts/resolveTs.ts scripts/imageMap.ts",
    "landing:generate": "node --env-file-if-exists=.env.images scripts/generateLanding.ts",
    "landing:shrink": "node scripts/generateLanding.ts --shrink",
    "logo:generate": "node --env-file-if-exists=.env.images scripts/generateLogo.ts",
    "logo:sheet": "node scripts/generateLogo.ts --sheet",
    "muscle:generate": "node --env-file-if-exists=.env.images scripts/generateMuscleMap.ts",
    "muscle:shrink": "node scripts/shrinkMuscleMaps.ts",
    "muscle:index": "node --import ./scripts/resolveTs.ts scripts/muscleMapIndex.ts",
    "check": "biome ci --error-on-warnings . && tsc --noEmit -p tsconfig.json && vitest run --root ../.. --project @tanren/mobile"
  },
  "dependencies": {
    "@expo/metro-runtime": "catalog:",
    "@tanren/shared": "workspace:*",
    "effect": "catalog:",
    "expo": "catalog:",
    "expo-audio": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-font": "catalog:",
    "expo-haptics": "catalog:",
    "expo-keep-awake": "catalog:",
    "expo-linking": "catalog:",
    "expo-notifications": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-updates": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
