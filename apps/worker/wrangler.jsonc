{
  // Top level = local: a bare `wrangler dev` can never reach Cloudflare (docs/design/local-dev.md §2).
  "name": "tanren",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // `global_fetch_strictly_public`: the OAuth provider's Client ID Metadata Document fetch requires
  // it (outbound fetch reaches public hosts only; Resend and Strava are public). Inheritable key:
  // `env.production` gets it from here (wrangler configuration, "Inheritable keys").
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The account has a workers.dev subdomain (cron triggers need it, 2026-10-27); this Worker must not be served on it.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "local",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "ALLOWED_ORIGINS": "http://localhost:8081,http://localhost:8790",
    "EMAIL_MODE": "console",
    "EMAIL_FROM": "Tanren <dev@tanren.local>",
    // Clearly fake, local only. Non-local environments must use real secrets (startup guard in Config.ts).
    "BETTER_AUTH_SECRET": "local-dev-only-not-a-secret-0000000000000000",
    "DEV_MCP_TOKEN": "local-dev-only-mcp-token",
    "MCP_RESOURCE_URL": "http://localhost:8787/mcp",
    // URL prefixes a native sign-in code may go to (exp://<host>:8081/--/auth/callback). `pnpm
    // dev:phone` overrides it with `--var NATIVE_RETURN_PREFIXES:exp://localhost:,exp://127.0.0.1:,exp://<LAN IP>:`.
    "NATIVE_RETURN_PREFIXES": "exp://localhost:,exp://127.0.0.1:",
    // Strava export (docs/design/integrations.md §3): console mode logs instead of calling Strava.
    "STRAVA_MODE": "console",
    // Optional simulation, never set here: `wrangler dev --var STRAVA_CONSOLE_FAIL:inactive` makes the
    // console createActivity fail like a Strava app whose subscription lapsed (Config.ts refuses it otherwise).
    "STRAVA_CLIENT_ID": "local-strava-client",
    // Clearly fake (32 zero bytes), local only. Config.ts refuses it outside `local`.
    "INTEGRATION_TOKEN_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  // Export queue drain every 5 minutes (docs/design/integrations.md §6). Local: `wrangler dev --test-scheduled`.
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanren",
      // Placeholder: locally it only names the SQLite file. The real id is set by the owner at step 7.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Production (docs/design/deploy.md §2). The D1 id was filled 2026-10-26 by the owner
  // (`wrangler d1 create tanren`); OAuth is stateless since ADR-0022 (no KV); secrets
  // (BETTER_AUTH_SECRET, RESEND_API_KEY) are never vars. `wrangler dev` ignores it.
  "env": {
    "production": {
      "name": "tanren",
      // Cron needs the account's workers.dev subdomain, but the API must stay on api/mcp.tanren.me only.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "api.tanren.me", "custom_domain": true },
        { "pattern": "mcp.tanren.me", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "BETTER_AUTH_URL": "https://api.tanren.me",
        "ALLOWED_ORIGINS": "https://tanren.me",
        "EMAIL_MODE": "provider",
        "EMAIL_FROM": "Tanren <login@tanren.me>",
        "MCP_RESOURCE_URL": "https://mcp.tanren.me/mcp",
        // Owner value (docs/design/deploy.md §2): `exps://u.expo.dev/<projectId>/` with the id from
        // `eas init` (app.json `extra.eas.projectId`), filled in 2026-10-27 (EAS-1). No `tanren://`
        // until universal links.
        "NATIVE_RETURN_PREFIXES": "exps://u.expo.dev/71f6f700-4c89-4627-8a93-b2fdd82974a5/",
        // console until the owner has a Strava app (O1/O2): flip to "provider" after O2, see docs/design/deploy.md §Strava secrets
        "STRAVA_MODE": "console",
        // Owner step O2 (docs/tasks/v4-strava.md): the Client ID from strava.com/settings/api.
        // Secrets, never vars: `wrangler secret put STRAVA_CLIENT_SECRET --env production` and
        // `wrangler secret put INTEGRATION_TOKEN_KEY --env production` (value: `openssl rand -base64 32`).
        "STRAVA_CLIENT_ID": "<owner: strava client id>"
      },
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanren",
          // Real production database (filled 2026-10-26).
          "database_id": "0cdfa785-fd69-4971-adf8-14a4acb89a01",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  }
}
