{
  "name": "@tanren/worker",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --show-interactive-dev-session=false",
    "db:migrate": "wrangler d1 migrations apply tanren --local",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -rf .wrangler/state && pnpm db:migrate && pnpm db:seed",
    "smoke": "tsx scripts/smoke.ts",
    "deploy:preflight": "tsx scripts/deployPreflight.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --root ../.. --project @tanren/worker --project @tanren/worker-workerd",
    "check": "biome ci --error-on-warnings . && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@tanren/db": "workspace:*",
    "@tanren/shared": "workspace:*",
    "agents": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uqr": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
