{
  // Test-only Worker config for the @tanren/worker-workerd vitest project (vitest.workerd.config.ts).
  // Each test file gets isolated D1 storage; nothing here reaches Cloudflare.
  "name": "tanren-worker-test",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // Same local values as wrangler.jsonc, so a workerd test can boot src/index.ts (module-scope `env`).
  "vars": {
    "ENVIRONMENT": "local",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "ALLOWED_ORIGINS": "http://localhost:8081,http://localhost:8790",
    "EMAIL_MODE": "console",
    "EMAIL_FROM": "Tanren <dev@tanren.local>",
    "BETTER_AUTH_SECRET": "local-dev-only-not-a-secret-0000000000000000",
    "DEV_MCP_TOKEN": "local-dev-only-mcp-token",
    "MCP_RESOURCE_URL": "http://localhost:8787/mcp",
    "NATIVE_RETURN_PREFIXES": "exp://localhost:,exp://127.0.0.1:,exp://192.168.1.5:",
    "STRAVA_MODE": "console",
    "STRAVA_CLIENT_ID": "local-strava-client",
    "INTEGRATION_TOKEN_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanren-test",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-oauth-kv" }]
}
