{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "32"
  },
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(basename:*)",
      "Bash(biome:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(chmod +x:*)",
      "Bash(cmp:*)",
      "Bash(corepack:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(export:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git worktree list:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(printf:*)",
      "Bash(pwd)",
      "Bash(realpath:*)",
      "Bash(rg:*)",
      "Bash(rm:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tar:*)",
      "Bash(test:*)",
      "Bash(time:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(true)",
      "Bash(tsc:*)",
      "Bash(uniq:*)",
      "Bash(unzip:*)",
      "Bash(vitest:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(wrangler:*)",
      "Bash(xargs:*)",
      "Edit(//private/tmp/claude-501/**)",
      "Read(//private/tmp/claude-501/**)",
      "WebFetch(domain:better-auth.com)",
      "WebFetch(domain:biomejs.dev)",
      "WebFetch(domain:blog.cloudflare.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:devblogs.microsoft.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:effect.website)",
      "WebFetch(domain:expo.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:marketplace.visualstudio.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:www.better-auth.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:www.sqlite.org)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebSearch",
      "mcp__plugin_cloudflare_cloudflare__docs",
      "mcp__plugin_cloudflare_cloudflare__search",
      "mcp__plugin_cloudflare_cloudflare__whoami",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.dev.vars)",
      "Read(./**/.dev.vars.*)"
    ],
    "ask": [
      "Bash(rm -r:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)"
    ],
    "additionalDirectories": [
      "/private/tmp/claude-501/-Users-lukas-Documents-Personal-tanren"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-index-ops.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh", "timeout": 30 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/em-cadence.sh post", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/em-cadence.sh stop", "timeout": 10 }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "expo@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true
  },
  "autoMemoryEnabled": true
}
